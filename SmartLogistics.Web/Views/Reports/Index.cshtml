@{
    ViewData["Title"] = "Trung tâm Báo cáo";
}

<div class="row g-3">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4">
            <h2 class="text-dark mb-1 font-weight-bold"><i class="bi bi-file-earmark-bar-graph text-primary me-2"></i>Trung Tâm Báo Cáo & Phân Tích</h2>
            <p class="text-muted mb-0">Xuất báo cáo hoạt động logistics, doanh thu vận hành dưới dạng PDF/Excel hoặc theo dõi trực quan qua Power BI.</p>
        </div>
    </div>

    <!-- Available Templates -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold mb-4">Các Mẫu Báo Cáo Sẵn Có</h5>
                <div class="list-group list-group-flush fs-8">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <div>
                            <h6 class="mb-1 text-dark fw-bold">Báo cáo hiệu suất giao hàng tháng 7/2026</h6>
                            <small class="text-muted">Định dạng: PDF - Dung lượng: 2.4 MB</small>
                        </div>
                        <button class="btn btn-sm btn-outline-success"><i class="bi bi-download"></i> Tải xuống</button>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <div>
                            <h6 class="mb-1 text-dark fw-bold">Báo cáo doanh thu & chi phí vận hành</h6>
                            <small class="text-muted">Định dạng: XLSX - Dung lượng: 1.1 MB</small>
                        </div>
                        <button class="btn btn-sm btn-outline-success"><i class="bi bi-download"></i> Tải xuống</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
