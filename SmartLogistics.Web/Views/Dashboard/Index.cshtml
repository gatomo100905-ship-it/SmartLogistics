@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="row g-3">
    <!-- Header Summary -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4 d-flex flex-row justify-content-between align-items-center">
            <div>
                <h2 class="text-dark mb-1 font-weight-bold">Bảng Điều Khiển Hệ Thống</h2>
                <p class="text-muted mb-0">Hệ thống Quản lý Vận hành & Phân tích Logistics thông minh.</p>
            </div>
            <span class="text-muted fs-8">Cập nhật: vừa xong</span>
        </div>
    </div>

    <!-- Widgets Row (contains Financial, Warehouse, Fleet, Fuel, AI, and Map) -->
    <div class="col-md-12">
        @await Html.PartialAsync("Components/Widgets")
    </div>

    <!-- Charts and Recents Row -->
    <div class="col-md-8">
        @await Html.PartialAsync("Components/Charts")
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-activity text-info"></i> Nhật ký hoạt động gần đây</h6>
                <ul class="list-unstyled mb-0 fs-8">
                    <li class="mb-3 border-bottom pb-2">
                        <span class="fw-bold d-block text-primary">Tài xế Nguyễn Văn A</span>
                        <span class="text-muted">Bắt đầu chuyến đi TR-881 tuyến HN-HP</span>
                        <small class="text-muted d-block mt-1">2 phút trước</small>
                    </li>
                    <li class="mb-3 border-bottom pb-2">
                        <span class="fw-bold d-block text-success">Đơn hàng #ORD-9921</span>
                        <span class="text-muted">Được tạo thành công bởi khách hàng Samsung VN</span>
                        <small class="text-muted d-block mt-1">10 phút trước</small>
                    </li>
                    <li>
                        <span class="fw-bold d-block text-warning">Kho bãi HN</span>
                        <span class="text-muted">Hoàn thành bốc xếp xe tải HP-441</span>
                        <small class="text-muted d-block mt-1">30 phút trước</small>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
