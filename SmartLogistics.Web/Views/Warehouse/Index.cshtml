@{
    ViewData["Title"] = "Quản lý kho bãi";
}

<div class="row g-3">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4 d-flex flex-row justify-content-between align-items-center">
            <div>
                <h2 class="text-dark mb-1 font-weight-bold"><i class="bi bi-house-door text-primary me-2"></i>Quản Lý Kho Bãi (WMS)</h2>
                <p class="text-muted mb-0">Quản lý sơ đồ các kho chứa hàng trung chuyển, phân khu lưu trữ và định vị vị trí ô kệ.</p>
            </div>
            <button class="btn btn-sm btn-primary">+ Thêm Kho Mới</button>
        </div>
    </div>

    <!-- Warehouses Grid -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm hover-scale h-100">
            <div class="card-body">
                <h5 class="card-title fw-bold text-primary">Kho Trung Chuyển Miền Bắc</h5>
                <p class="text-muted fs-8 mb-3">Địa chỉ: Đường số 5, KCN Tiên Sơn, Bắc Ninh</p>
                <div class="d-flex justify-content-between fs-8 border-top pt-2 mb-3">
                    <span>Sức chứa: <strong>10,000 m³</strong></span>
                    <span>Tỷ lệ lấp đầy: <strong class="text-danger">85%</strong></span>
                </div>
                <div class="progress mb-3" style="height: 6px;">
                    <div class="progress-bar bg-danger" role="progressbar" style="width: 85%"></div>
                </div>
                <button class="btn btn-sm btn-primary w-100">Quản lý sơ đồ kho</button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm hover-scale h-100">
            <div class="card-body">
                <h5 class="card-title fw-bold text-success">Kho Trung Chuyển Miền Nam</h5>
                <p class="text-muted fs-8 mb-3">Địa chỉ: KCN Cát Lái, Quận 2, TP. Hồ Chí Minh</p>
                <div class="d-flex justify-content-between fs-8 border-top pt-2 mb-3">
                    <span>Sức chứa: <strong>15,000 m³</strong></span>
                    <span>Tỷ lệ lấp đầy: <strong class="text-success">65%</strong></span>
                </div>
                <div class="progress mb-3" style="height: 6px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 65%"></div>
                </div>
                <button class="btn btn-sm btn-primary w-100">Quản lý sơ đồ kho</button>
            </div>
        </div>
    </div>
</div>
