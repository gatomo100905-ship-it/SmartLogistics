<div class="row g-3">
    <!-- Row 1: Financial Cards -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #0ea5e9, #2563eb);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fs-8 text-white-50">DOANH THU THÁNG</span>
                        <h3 class="mb-0 fw-bold mt-1">1.200Mđ</h3>
                    </div>
                    <div class="bg-white bg-opacity-20 p-2 rounded">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 fs-8 text-white-50">
                    <span class="text-white fw-bold"><i class="bi bi-arrow-up"></i> +12.5%</span> so với tháng trước
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #f43f5e, #e11d48);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fs-8 text-white-50">CHI PHÍ VẬN HÀNH</span>
                        <h3 class="mb-0 fw-bold mt-1">320Mđ</h3>
                    </div>
                    <div class="bg-white bg-opacity-20 p-2 rounded">
                        <i class="bi bi-credit-card fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 fs-8 text-white-50">
                    <span class="text-white fw-bold"><i class="bi bi-arrow-down"></i> -4.2%</span> giảm nhờ tối ưu xăng
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #10b981, #059669);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fs-8 text-white-50">LỢI NHUẬN RÒNG</span>
                        <h3 class="mb-0 fw-bold mt-1">880Mđ</h3>
                    </div>
                    <div class="bg-white bg-opacity-20 p-2 rounded">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 fs-8 text-white-50">
                    <span class="text-white fw-bold"><i class="bi bi-arrow-up"></i> +18.7%</span> vượt chỉ tiêu tháng
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fs-8 text-white-50">DÒNG TIỀN (CASH FLOW)</span>
                        <h3 class="mb-0 fw-bold mt-1">+940Mđ</h3>
                    </div>
                    <div class="bg-white bg-opacity-20 p-2 rounded">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 fs-8 text-white-50">
                    <span class="text-white fw-bold">An toàn</span> hệ số thanh toán 2.8
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Warehouse, Fleet & Fuel -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-house-door text-primary"></i> Dung Lượng Kho Bãi</h6>
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">75%</h4>
                        <span class="fs-8 text-muted">Đang sử dụng: 7,500m³</span>
                    </div>
                    <svg width="80" height="80" class="me-2">
                        <circle cx="40" cy="40" r="32" stroke="#e2e8f0" stroke-width="8" fill="transparent" />
                        <circle cx="40" cy="40" r="32" stroke="#2563eb" stroke-width="8" fill="transparent"
                                stroke-dasharray="201" stroke-dashoffset="50" stroke-linecap="round" />
                    </svg>
                </div>
                <div class="mt-3">
                    <div class="d-flex justify-content-between fs-8 text-muted mb-1">
                        <span>Kho A (Hà Nội): 85%</span>
                        <span>Kho B (HCM): 65%</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 75%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-truck text-success"></i> Hiệu Suất Vận Chuyển</h6>
                <div class="row">
                    <div class="col-6 border-end text-center">
                        <span class="fs-8 text-muted">Đúng Hạn (On-time)</span>
                        <h4 class="fw-bold text-success mt-1">96.8%</h4>
                        <span class="fs-9 text-success"><i class="bi bi-caret-up-fill"></i> +1.2%</span>
                    </div>
                    <div class="col-6 text-center">
                        <span class="fs-8 text-muted">Giao Trễ (Delay)</span>
                        <h4 class="fw-bold text-danger mt-1">3.2%</h4>
                        <span class="fs-9 text-success"><i class="bi bi-caret-down-fill"></i> -0.8%</span>
                    </div>
                </div>
                <div class="mt-3 fs-8 text-muted bg-light p-2 rounded text-center">
                    <i class="bi bi-info-circle text-primary"></i> 2 chuyến trễ do mưa bão tại Miền Trung
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-2"><i class="bi bi-fuel-pump text-danger"></i> Chi Phí Nhiên Liệu</h6>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <h4 class="mb-0 fw-bold">125.4 Mđ</h4>
                        <span class="fs-8 text-muted">Tháng này: 6,100 Lít</span>
                    </div>
                    <span class="badge bg-danger-subtle text-danger">-2.4% so với tháng trước</span>
                </div>
                <svg viewBox="0 0 300 50" class="w-100" style="max-height: 40px;">
                    <path d="M 0,40 L 50,35 L 100,45 L 150,25 L 200,30 L 250,15 L 300,10" fill="none" stroke="#ef4444" stroke-width="3" stroke-linecap="round"></path>
                    <path d="M 0,40 L 50,35 L 100,45 L 150,25 L 200,30 L 250,15 L 300,10 L 300,50 L 0,50 Z" fill="rgba(239, 68, 68, 0.1)"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- Row 3: AI prediction & Real-time Map -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #1e1b4b, #311042); color: #fff;">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="fw-bold mb-3 text-white-50"><i class="bi bi-cpu text-warning"></i> AI Prediction Insights</h6>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-lightbulb-fill text-warning fs-4 me-3 mt-1"></i>
                        <div>
                            <span class="fs-8 text-white-50 d-block">DỰ BÁO NHU CẦU (DEMAND FORECAST)</span>
                            <span class="fs-7 text-white">Số lượng đơn hàng dự kiến tăng <strong class="text-warning">+12%</strong> vào 2 ngày tiếp theo. Đề xuất tăng cường xe tải nhẹ tuyến Hà Nội - Hải Phòng.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="bi bi-shield-exclamation text-info fs-4 me-3 mt-1"></i>
                        <div>
                            <span class="fs-8 text-white-50 d-block">CẢNH BÁO TỒN KHO AN TOÀN</span>
                            <span class="fs-7 text-white">SKU-BOX-M tại Kho A sắp cạn. Đề xuất nhập thêm <strong class="text-info">500 đơn vị</strong> trước ngày 03/08.</span>
                        </div>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-top border-white border-opacity-10 fs-8 text-white-50 text-end">
                    <span>Độ tin cậy mô hình: <strong>94.2%</strong></span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-map text-primary"></i> Bản Đồ Giám Sát Thời Gian Thực (Live Fleet Map)</h6>
                    <span class="badge bg-success animate-pulse"><i class="bi bi-circle-fill fs-9 me-1"></i> Trực tiếp</span>
                </div>
                <div id="liveFleetMap" style="height: 250px; border-radius: 8px; border: 1px solid #e2e8f0; z-index: 1;"></div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var map = L.map('liveFleetMap').setView([16.0471, 108.2062], 5);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);

        var locations = [
            { name: "Xe Tải HN-182 (Đang giao hàng)", lat: 21.0285, lng: 105.8542, type: "truck" },
            { name: "Container HCM-991 (Vận chuyển Bắc Nam)", lat: 10.8231, lng: 106.6297, type: "truck" },
            { name: "Xe Tải DN-440 (Trung chuyển Đà Nẵng)", lat: 16.0471, lng: 108.2062, type: "truck" }
        ];

        locations.forEach(function (loc) {
            var marker = L.marker([loc.lat, loc.lng]).addTo(map);
            marker.bindPopup("<b>" + loc.name + "</b><br>Tọa độ: " + loc.lat + ", " + loc.lng);
        });
    });
</script>

<style>
    .animate-pulse {
        animation: pulse-animation 2s infinite;
    }
    @@keyframes pulse-animation {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    .fs-7 { font-size: 0.85rem; }
    .fs-8 { font-size: 0.75rem; }
    .fs-9 { font-size: 0.65rem; }
</style>
