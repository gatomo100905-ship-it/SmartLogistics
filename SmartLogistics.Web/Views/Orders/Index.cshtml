@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="row g-3">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4 d-flex flex-row justify-content-between align-items-center">
            <div>
                <h2 class="text-dark mb-1 font-weight-bold"><i class="bi bi-cart3 text-primary me-2"></i>Quản Lý Đơn Hàng (Orders)</h2>
                <p class="text-muted mb-0">Tiếp nhận đơn hàng vận chuyển từ đối tác, tạo vận đơn và giám sát trạng thái giao hàng.</p>
            </div>
            <button class="btn btn-sm btn-primary">+ Tạo Đơn Hàng Mới</button>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-8">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Đơn Hàng</th>
                                <th>Khách Hàng</th>
                                <th>Ngày Tạo</th>
                                <th>Điểm Giao</th>
                                <th>Tổng Tiền</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold text-primary">#ORD-9921</td>
                                <td>Samsung VN</td>
                                <td>31/07/2026</td>
                                <td>KCN Yên Phong, Bắc Ninh</td>
                                <td class="fw-bold">45.000.000đ</td>
                                <td><span class="badge bg-info text-dark">Mới tạo</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary">Duyệt đơn</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-primary">#ORD-9920</td>
                                <td>LG Display</td>
                                <td>30/07/2026</td>
                                <td>KCN Tràng Duệ, Hải Phòng</td>
                                <td class="fw-bold">12.500.000đ</td>
                                <td><span class="badge bg-success">Đang vận chuyển</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary">Theo dõi</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
