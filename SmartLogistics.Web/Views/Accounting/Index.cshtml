@{
    ViewData["Title"] = "Kế toán & Hóa đơn";
}

<div class="row g-3">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4 d-flex flex-row justify-content-between align-items-center">
            <div>
                <h2 class="text-dark mb-1 font-weight-bold"><i class="bi bi-receipt text-primary me-2"></i>Kế Toán Công Nợ & Hóa Đơn</h2>
                <p class="text-muted mb-0">Quản lý hóa đơn phải thu từ khách hàng, lập phiếu thu và đối soát thanh toán tự động.</p>
            </div>
            <button class="btn btn-sm btn-primary">+ Xuất Hóa Đơn</button>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-8">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Hóa Đơn</th>
                                <th>Khách Hàng</th>
                                <th>Ngày Phát Hành</th>
                                <th>Ngày Đáo Hạn</th>
                                <th>Số Tiền</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold text-primary">INV-2026-001</td>
                                <td>Tập đoàn Hòa Phát</td>
                                <td>31/07/2026</td>
                                <td>15/08/2026</td>
                                <td class="fw-bold">120.000.000đ</td>
                                <td><span class="badge bg-warning text-dark">Chờ thanh toán</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary">Gửi nhắc nhở</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-primary">INV-2026-002</td>
                                <td>Công ty Trường Hải</td>
                                <td>28/07/2026</td>
                                <td>10/08/2026</td>
                                <td class="fw-bold">85.000.000đ</td>
                                <td><span class="badge bg-success">Đã thanh toán</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary">Chi tiết</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
