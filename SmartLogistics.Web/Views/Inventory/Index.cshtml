@{
    ViewData["Title"] = "Quản lý tồn kho";
}

<div class="row g-3">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm p-4 d-flex flex-row justify-content-between align-items-center">
            <div>
                <h2 class="text-dark mb-1 font-weight-bold"><i class="bi bi-box text-primary me-2"></i>Quản Lý Hàng Tồn Kho (Inventory)</h2>
                <p class="text-muted mb-0">Theo dõi số lượng hàng hóa lưu kho, nhập hàng, xuất hàng và cảnh báo tồn kho an toàn thời gian thực.</p>
            </div>
            <button class="btn btn-sm btn-primary">+ Nhập Kho</button>
        </div>
    </div>

    <!-- Inventory Table -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-8">
                        <thead class="table-light">
                            <tr>
                                <th>Mã SKU</th>
                                <th>Tên Sản Phẩm</th>
                                <th>Kho Lưu Trữ</th>
                                <th>Phân Khu (Zone)</th>
                                <th>Ô kệ (Bin)</th>
                                <th>Số Lượng Tồn</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">SKU-BOX-M</td>
                                <td>Thùng Carton cỡ trung</td>
                                <td>Kho A (Hà Nội)</td>
                                <td>Zone 1 - Khu A</td>
                                <td>A-12-3</td>
                                <td class="fw-bold">150</td>
                                <td><span class="badge bg-danger">Sắp hết hàng</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary">Điều chỉnh</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">SKU-PAL-W</td>
                                <td>Pallet gỗ tiêu chuẩn</td>
                                <td>Kho B (HCM)</td>
                                <td>Zone 2 - Khu B</td>
                                <td>B-05-1</td>
                                <td class="fw-bold">1,200</td>
                                <td><span class="badge bg-success">An toàn</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary">Điều chỉnh</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
